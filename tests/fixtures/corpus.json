{
  "schemaVersion": 1,
  "provenance": "Self-authored verse-fmt cases; MIT OR Apache-2.0; tool/parser expectations only, UEFN acceptance pending.",
  "cases": [
    {"id":"empty", "category":"encoding", "input":"", "expected":""},
    {"id":"bom-only", "category":"encoding", "input":"\ufeff", "expected":"\ufeff"},
    {"id":"lf-integer", "category":"literal", "input":"A:=1  \n", "expected":"A := 1\n"},
    {"id":"crlf-integer", "category":"encoding", "input":"A:=1  \r\n", "expected":"A := 1\r\n"},
    {"id":"bom-crlf", "category":"encoding", "input":"\ufeffA:=1\r\n", "expected":"\ufeffA := 1\r\n"},
    {"id":"no-final-newline", "category":"layout", "input":"A:=1", "expected":"A := 1\n"},
    {"id":"negative-integer", "category":"literal", "input":"A:=-1\n", "expected":"A := -1\n"},
    {"id":"float-literal", "category":"literal", "input":"A:=1.25\n", "expected":"A := 1.25\n"},
    {"id":"hex-literal", "category":"literal", "input":"A:=0xFF\n", "expected":"A := 0xFF\n"},
    {"id":"logic-literal", "category":"literal", "input":"A:=true\n", "expected":"A := true\n"},
    {"id":"addition", "category":"expression", "input":"A:=1+2\n", "expected":"A := 1 + 2\n"},
    {"id":"precedence", "category":"expression", "input":"A:=1+2*3\n", "expected":"A := 1 + 2 * 3\n"},
    {"id":"parentheses", "category":"expression", "input":"A:=( 1+2 )\n", "expected":"A := (1 + 2)\n"},
    {"id":"string", "category":"protected", "input":"A:=\"keep  spaces\"\n", "expected":"A := \"keep  spaces\"\n"},
    {"id":"unicode-string", "category":"protected", "input":"A:=\"日😀é\"\n", "expected":"A := \"日😀é\"\n"},
    {"id":"escaped-quote", "category":"protected", "input":"A:=\"say \\\"yes\\\"\"\n", "expected":"A := \"say \\\"yes\\\"\"\n"},
    {"id":"interpolation", "category":"protected", "input":"A:=\"value {N}\"\n", "expected":"A := \"value {N}\"\n"},
    {"id":"nested-interpolation", "category":"protected", "input":"A:=\"{Foo(\"inner\")}\"\n", "expected":"A := \"{Foo(\"inner\")}\"\n"},
    {"id":"character", "category":"protected", "input":"A:='x'\n", "expected":"A := 'x'\n"},
    {"id":"line-comment-eof", "category":"protected", "input":"# keep  ", "expected":"# keep  \n"},
    {"id":"line-comment-inline", "category":"protected", "input":"A:=1 # keep  \n", "expected":"A := 1 # keep  \n"},
    {"id":"nested-comments", "category":"protected", "input":"<# outer <# inner #> #>\nA:=1\n", "expected":"<# outer <# inner #> #>\nA := 1\n"},
    {"id":"multiline-comment", "category":"protected", "input":"<# keep\n  literal indent  \n#>\nA:=1\n", "expected":"<# keep\n  literal indent  \n#>\nA := 1\n"},
    {"id":"using-path", "category":"declaration", "input":"using { /Fortnite.com/Devices }\n", "expected":"using { /Fortnite.com/Devices }\n"},
    {"id":"field-indent", "category":"declaration", "input":"counter:=class:\n  Value : int=1\n", "expected":"counter := class:\n    Value:int = 1\n"},
    {"id":"method-parameters", "category":"declaration", "input":"First ( X : int , Y : int ) : int= X\n", "expected":"First(X:int, Y:int):int = X\n"},
    {"id":"two-methods", "category":"block-ownership", "input":"counter:=class:\n  One():int=\n    1\n  Two():int=\n    2\n", "expected":"counter := class:\n    One():int =\n        1\n    Two():int =\n        2\n"},
    {"id":"call-arguments", "category":"expression", "input":"A:=Foo ( 1 , 2 )\n", "expected":"A := Foo(1, 2)\n"},
    {"id":"failable-call", "category":"expression", "input":"A:=Foo [ 1 ]\n", "expected":"A := Foo[1]\n"},
    {"id":"member-access", "category":"expression", "input":"A:=Item.Value\n", "expected":"A := Item.Value\n"},
    {"id":"array", "category":"collection", "input":"A:=array{1,2,3}\n", "expected":"A := array{1, 2, 3}\n"},
    {"id":"reject-map-literal", "category":"coverage", "input":"A:=map{\"x\" => 1}\n", "reject":true},
    {"id":"option", "category":"collection", "input":"A:=option{1}\n", "expected":"A := option{1}\n"},
    {"id":"tuple", "category":"collection", "input":"A:=(1,2)\n", "expected":"A := (1, 2)\n"},
    {"id":"module", "category":"declaration", "input":"M:=module:\n  A:=1\n", "expected":"M := module:\n    A := 1\n"},
    {"id":"enum", "category":"declaration", "input":"Color:=enum:\n  Red\n  Blue\n", "expected":"Color := enum:\n    Red\n    Blue\n"},
    {"id":"struct", "category":"declaration", "input":"Point:=struct:\n  X : int=1\n", "expected":"Point := struct:\n    X:int = 1\n"},
    {"id":"interface", "category":"declaration", "input":"Readable:=interface:\n  Get():int\n", "expected":"Readable := interface:\n    Get():int\n"},
    {"id":"effect", "category":"specifier", "input":"Wait()<suspends>:void=\n  Sleep(0.0)\n", "expected":"Wait()<suspends>:void =\n    Sleep(0.0)\n"},
    {"id":"editable-field", "category":"attribute", "input":"counter:=class:\n  @editable\n  Value:int=1\n", "expected":"counter := class:\n    @editable\n    Value:int = 1\n"},
    {"id":"var-and-set", "category":"statement", "input":"f():void=\n  var N:int=0\n  set N+=1\n", "expected":"f():void =\n    var N:int = 0\n    set N += 1\n"},
    {"id":"local-using", "category":"declaration", "input":"using { Helpers }\n", "expected":"using { Helpers }\n"},
    {"id":"local-using-dotted", "category":"declaration", "input":"using { Demo.Helpers.More }\n", "expected":"using { Demo.Helpers.More }\n"},
    {"id":"braced-enum-lines", "category":"declaration", "input":"shade := enum{\n  Light,\n  Dark\n}\n", "expected":"shade := enum{\n  Light,\n  Dark\n}\n"},
    {"id":"braced-enum-inline", "category":"declaration", "input":"shade := enum{Light,Dark}\n", "expected":"shade := enum{Light, Dark}\n"},
    {"id":"typed-local", "category":"statement", "input":"F():void=\n  Label:string=\"hello\"\n", "expected":"F():void =\n    Label:string = \"hello\"\n"},
    {"id":"typed-local-interpolation", "category":"statement", "input":"F():void=\n  Count:=1\n  Label:string=\"{Count}\"\n", "expected":"F():void =\n    Count := 1\n    Label:string = \"{Count}\"\n"},
    {"id":"empty-class-base-list", "category":"declaration", "input":"Empty<public>:=class():\n  Value : int=1\n", "expected":"Empty<public> := class():\n    Value:int = 1\n"},
    {"id":"if-binding-condition", "category":"control", "input":"Check():void=\n    if:\n        Value:=1\n    then:\n        Print(\"ok\")\n", "expected":"Check():void =\n    if:\n        Value := 1\n    then:\n        Print(\"ok\")\n"},
    {"id":"nested-indented-construction", "category":"collection", "input":"Build():void=\n  Canvas:canvas=canvas:\n    Slots:=array:\n      canvas_slot:\n        ZOrder:={Z:=5}\n", "expected":"Build():void =\n    Canvas:canvas = canvas:\n        Slots := array:\n            canvas_slot:\n                ZOrder := {Z := 5}\n"},
    {"id":"return", "category":"control", "input":"f():int=\n  return 1\n", "expected":"f():int =\n    return 1\n"},
    {"id":"loop-break", "category":"control", "input":"f():void=\n  loop:\n    break\n", "expected":"f():void =\n    loop:\n        break\n"},
    {"id":"braced-body", "category":"block", "input":"f():int={1}\n", "expected":"f():int = {1}\n"},
    {"id":"blank-runs", "category":"layout", "input":"A:=1\n\n\nB:=2\n", "expected":"A := 1\n\nB := 2\n"},
    {"id":"indented-comment", "category":"protected", "input":"f():void=\n  # keep\n  Print(\"x\")\n", "expected":"f():void =\n  # keep\n    Print(\"x\")\n"},
    {"id":"reject-incomplete-string", "category":"negative-protected", "input":"A:=\"open", "reject":true},
    {"id":"reject-incomplete-comment", "category":"negative-protected", "input":"<# open", "reject":true},
    {"id":"reject-nested-comment", "category":"negative-protected", "input":"<# outer <# inner #>", "reject":true},
    {"id":"reject-indented-comment", "category":"coverage", "input":"<#> comment\n  text\n", "reject":true},
    {"id":"reject-leading-hash-string", "category":"coverage", "input":"A:=\"# text\"\n", "reject":true},
    {"id":"reject-unicode-identifier", "category":"coverage", "input":"得点:=1\n", "reject":true},
    {"id":"reject-quoted-identifier", "category":"coverage", "input":"'identifier':=1\n", "reject":true},
    {"id":"reject-markup", "category":"coverage", "input":"A:=<p>text</p>\n", "reject":true},
    {"id":"typed-top-level", "category":"declaration", "input":"A:int=1\n", "expected":"A:int = 1\n"},
    {"id":"reject-multiline-string", "category":"coverage", "input":"A:=\"one\ntwo\"\n", "reject":true},
    {"id":"reject-escape", "category":"negative-protected", "input":"A:=\"bad\\z\"\n", "reject":true},
    {"id":"mixed-eol-preserved", "category":"encoding", "input":"A:=1\r\nB:=2\n", "expected":"A := 1\r\nB := 2\n"},
    {"id":"reject-bare-cr", "category":"encoding", "input":"A:=1\rB:=2", "reject":true},
    {"id":"reject-nul", "category":"encoding", "input":"A:=1\u0000\n", "reject":true},
    {"id":"reject-unclosed-paren", "category":"negative-block", "input":"A:=(1\n", "reject":true},
    {"id":"reject-mismatched-bracket", "category":"negative-block", "input":"A:=(1]\n", "reject":true},
    {"id":"reject-tab-indent", "category":"negative-block", "input":"f():void=\n\tPrint(\"x\")\n", "reject":true},
    {"id":"reject-ambiguous-indent", "category":"negative-block", "input":"A:=1\n  B:=2\n", "reject":true},
    {"id":"reject-inline-binary-body", "category":"coverage", "input":"Add(X:int,Y:int):int = X+Y\n", "reject":true}
  ]
}
